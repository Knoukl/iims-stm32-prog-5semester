{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build",
            "type": "shell",
            "command": "py",
            "args": [
                "build.py",
                "build"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "Flash",
            "type": "shell",
            "command": "py",
            "args": [
                "build.py",
                "flash"
            ],
            "group": "build",
            "problemMatcher": "$gcc"
        },
        {
            "label": "Clean",
            "type": "shell",
            "command": "py",
            "args": [
                "build.py",
                "clean"
            ],
            "problemMatcher": []
        }
    ]
}
